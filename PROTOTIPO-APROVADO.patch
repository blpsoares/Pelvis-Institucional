+body:has(#flatos-vaginais-flacidez-vaginal:target) .fisioIndice a[href="#flatos-vaginais-flacidez-vaginal"],
+body:has(#incontinencia-anal-fezes-ou-flatos:target) .fisioIndice a[href="#incontinencia-anal-fezes-ou-flatos"],
+body:has(#constipacao-intestinal-anismo:target) .fisioIndice a[href="#constipacao-intestinal-anismo"],
+body:has(#dor-pelvica-cronica-endometriose:target) .fisioIndice a[href="#dor-pelvica-cronica-endometriose"],
+body:has(#dismenorreia-colica-menstrual:target) .fisioIndice a[href="#dismenorreia-colica-menstrual"],
+body:has(#redesignacao-sexual:target) .fisioIndice a[href="#redesignacao-sexual"] {
+    background-color: var(--rosa1);
+    border-color: var(--roxo1);
+    color: var(--roxo6);
+  }
+}
+
+
+/* O hover e o ativo estavam visualmente iguais (mesmo fundo, mesmo ponto
+   verde), entao passar o mouse por um item dava a impressao de que ele era o
+   conteudo aberto. O ativo ganha uma barra verde a esquerda, que o hover nao
+   tem — a diferenca fica legivel mesmo com o cursor parado sobre outro item. */
+.fisioIndiceGrupo:first-child li:first-child a,
+body:has(#gestacao-e-pos-parto:target) .fisioIndice a[href="#gestacao-e-pos-parto"],
+body:has(#diastase-abdominal:target) .fisioIndice a[href="#diastase-abdominal"],
+body:has(#incontinencia-urinaria-de-esforco:target) .fisioIndice a[href="#incontinencia-urinaria-de-esforco"],
+body:has(#incontinencia-urinaria-de-urgencia:target) .fisioIndice a[href="#incontinencia-urinaria-de-urgencia"],
+body:has(#incontinencia-urinaria-mista:target) .fisioIndice a[href="#incontinencia-urinaria-mista"],
+body:has(#prolapsos-de-orgaos-pelvicos-bexiga-caida:target) .fisioIndice a[href="#prolapsos-de-orgaos-pelvicos-bexiga-caida"],
+body:has(#bexiga-hiperativa-hiperatividade-do-detrusor:target) .fisioIndice a[href="#bexiga-hiperativa-hiperatividade-do-detrusor"],
+body:has(#incontinencia-pos-prostatectomia:target) .fisioIndice a[href="#incontinencia-pos-prostatectomia"],
+body:has(#sindrome-da-bexiga-dolorosa-cistite-intersticial:target) .fisioIndice a[href="#sindrome-da-bexiga-dolorosa-cistite-intersticial"],
+body:has(#vaginismo:target) .fisioIndice a[href="#vaginismo"],
+body:has(#vulvodinia:target) .fisioIndice a[href="#vulvodinia"],
+body:has(#flatos-vaginais-flacidez-vaginal:target) .fisioIndice a[href="#flatos-vaginais-flacidez-vaginal"],
+body:has(#incontinencia-anal-fezes-ou-flatos:target) .fisioIndice a[href="#incontinencia-anal-fezes-ou-flatos"],
+body:has(#constipacao-intestinal-anismo:target) .fisioIndice a[href="#constipacao-intestinal-anismo"],
+body:has(#dor-pelvica-cronica-endometriose:target) .fisioIndice a[href="#dor-pelvica-cronica-endometriose"],
+body:has(#dismenorreia-colica-menstrual:target) .fisioIndice a[href="#dismenorreia-colica-menstrual"],
+body:has(#redesignacao-sexual:target) .fisioIndice a[href="#redesignacao-sexual"] {
+  box-shadow: inset 3px 0 0 0 var(--verde3);
+}
+body:has(.fisioCondicao:target)
+  .fisioIndiceGrupo:first-child
+  li:first-child
+  a {
+  box-shadow: none;
+}
+
+@media (max-width: 1000px) {
+  /* na pilula a barra lateral nao cabe: o ativo fica com borda roxa cheia */
+  .fisioIndiceGrupo:first-child li:first-child a,
+  body:has(#gestacao-e-pos-parto:target) .fisioIndice a[href="#gestacao-e-pos-parto"],
+body:has(#diastase-abdominal:target) .fisioIndice a[href="#diastase-abdominal"],
+body:has(#incontinencia-urinaria-de-esforco:target) .fisioIndice a[href="#incontinencia-urinaria-de-esforco"],
+body:has(#incontinencia-urinaria-de-urgencia:target) .fisioIndice a[href="#incontinencia-urinaria-de-urgencia"],
+body:has(#incontinencia-urinaria-mista:target) .fisioIndice a[href="#incontinencia-urinaria-mista"],
+body:has(#prolapsos-de-orgaos-pelvicos-bexiga-caida:target) .fisioIndice a[href="#prolapsos-de-orgaos-pelvicos-bexiga-caida"],
+body:has(#bexiga-hiperativa-hiperatividade-do-detrusor:target) .fisioIndice a[href="#bexiga-hiperativa-hiperatividade-do-detrusor"],
+body:has(#incontinencia-pos-prostatectomia:target) .fisioIndice a[href="#incontinencia-pos-prostatectomia"],
+body:has(#sindrome-da-bexiga-dolorosa-cistite-intersticial:target) .fisioIndice a[href="#sindrome-da-bexiga-dolorosa-cistite-intersticial"],
+body:has(#vaginismo:target) .fisioIndice a[href="#vaginismo"],
+body:has(#vulvodinia:target) .fisioIndice a[href="#vulvodinia"],
+body:has(#flatos-vaginais-flacidez-vaginal:target) .fisioIndice a[href="#flatos-vaginais-flacidez-vaginal"],
+body:has(#incontinencia-anal-fezes-ou-flatos:target) .fisioIndice a[href="#incontinencia-anal-fezes-ou-flatos"],
+body:has(#constipacao-intestinal-anismo:target) .fisioIndice a[href="#constipacao-intestinal-anismo"],
+body:has(#dor-pelvica-cronica-endometriose:target) .fisioIndice a[href="#dor-pelvica-cronica-endometriose"],
+body:has(#dismenorreia-colica-menstrual:target) .fisioIndice a[href="#dismenorreia-colica-menstrual"],
+body:has(#redesignacao-sexual:target) .fisioIndice a[href="#redesignacao-sexual"] {
+    box-shadow: none;
+    border-color: var(--roxo4);
+    border-width: 2px;
+    font-weight: 600;
+  }
+  body:has(.fisioCondicao:target)
+    .fisioIndiceGrupo:first-child
+    li:first-child
+    a {
+    border-color: var(--cinza5);
+    border-width: 1px;
+    font-weight: 400;
+  }
+}
+
+/* ============================================================
+   PROTÓTIPO COORDENADOR — FAQ, opção B (aprovada)
+   Linha roxa acima e abaixo, marcador roxo, sem caixa e sem toggle.
+   Replicado nos 4 arquivos de proposito: os styles.css das paginas nao sao
+   escopados — todos declaram `.faqSection` no escopo global e entram no mesmo
+   bundle, entao quem e importado por ultimo vence, seja qual for a pagina.
+   ============================================================ */
+.faqSection {
+  max-width: 78rem !important;
+  margin-inline: auto;
+  padding-block: 7rem;
+}
+
+.faqSection .spanLabel {
+  align-self: flex-start;
+}
+
+.faqSection h2 {
+  font-size: 3.2rem;
+  line-height: 1.2;
+  max-width: 56rem;
+  margin-bottom: 4rem;
+  text-wrap: balance;
+}
+
+/* --- o par --- */
+.faqSection .faqItem {
+  position: relative;
+  background: none;
+  border: 0;
+  border-radius: 0;
+  padding: 2.8rem 0 3rem;
+  max-width: none;
+  display: grid;
+  grid-template-columns: 2.6rem minmax(0, 1fr);
+  column-gap: 1.6rem;
+}
+
+/* A linha nasce saturada a esquerda e desvanece — evita o peso de um traco
+   cheio de ponta a ponta e ancora o olho onde o marcador esta. */
+.faqSection .faqItem::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 2px;
+  background: linear-gradient(
+    90deg,
+    var(--roxo4) 0%,
+    var(--roxo4) 12%,
+    var(--roxo1) 42%,
+    rgba(150, 104, 168, 0.22) 100%
+  );
+}
+
+.faqSection > .boxAnimation:last-of-type .faqItem::after {
+  content: "";
+  position: absolute;
+  bottom: 0;
+  left: 0;
+  right: 0;
+  height: 2px;
+  background: linear-gradient(
+    90deg,
+    var(--roxo4) 0%,
+    var(--roxo4) 12%,
+    var(--roxo1) 42%,
+    rgba(150, 104, 168, 0.22) 100%
+  );
+}
+
+/* --- marcador: losango, nao "+" --- */
+/* Um "+" anuncia que abre alguma coisa; aqui nada abre. O losango marca o
+   inicio do par sem prometer interacao. */
+.faqSection .faqItem h3::before {
+  content: "";
+  position: absolute;
+  left: 0.55rem;
+  width: 0.9rem;
+  height: 0.9rem;
+  margin-top: 1rem;
+  background: var(--roxo4);
+  transform: rotate(45deg);
+  border-radius: 0.15rem;
+}
+
+.faqSection .faqItem h3 {
+  grid-column: 2;
+  font-family: var(--taviraj);
+  font-size: 2.3rem;
+  font-weight: 500;
+  line-height: 1.32;
+  color: var(--roxo2);
+  margin-bottom: 1.2rem;
+  max-width: 52rem;
+  text-wrap: pretty;
+}
+
+.faqSection .faqItem p {
+  grid-column: 2;
+  color: var(--cinza);
+  line-height: 1.75;
+  max-width: none;
+}
+
+@media (max-width: 1000px) {
+  .faqSection {
+    padding-block: 4.5rem;
+  }
+  .faqSection h2 {
+    font-size: 2.6rem;
+    margin-bottom: 3rem;
+  }
+  .faqSection .faqItem {
+    grid-template-columns: 2rem minmax(0, 1fr);
+    column-gap: 1.2rem;
+    padding: 2.2rem 0 2.4rem;
+  }
+  .faqSection .faqItem h3 {
+    font-size: 2rem;
+  }
+  .faqSection .faqItem h3::before {
+    left: 0.3rem;
+    width: 0.8rem;
+    height: 0.8rem;
+    margin-top: 0.8rem;
+  }
+}
