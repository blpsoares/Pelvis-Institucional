+  }
+
+  .fisioIndiceFamilia,
+  .fisioIndiceTitulo {
+    padding-left: 0;
+  }
+
+  .fisioIndice li + li {
+    margin-top: 0;
+  }
+}
+
+@media (min-width: 601px) and (max-width: 1000px) {
