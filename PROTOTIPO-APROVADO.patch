+
+/* ============================================================
+   PROTÓTIPO COORDENADOR — redesign do índice
+   Problemas atacados: não parecia clicável, caixa sem hierarquia,
+   scroll interno no desktop, e ~630px de altura no mobile.
+   ============================================================ */
+
+/* -- cartão: some o cinza chapado, entra branco com borda fina -- */
+.fisioIndice {
+  border: 1px solid var(--rule-idx, #e9e2ee);
+  border-radius: 1.6rem;
+  padding: 1.8rem 1.6rem 1.6rem;
+  background-color: var(--branco);
+  box-shadow: 0 1px 2px rgba(94, 29, 138, 0.04),
+    0 8px 24px -16px rgba(94, 29, 138, 0.18);
+}
+
+.fisioIndiceTitulo {
+  font-size: 1.15rem;
+  letter-spacing: 0.14rem;
+  color: var(--roxo2);
+  padding-left: 1rem;
+  margin-bottom: 1.4rem;
+}
+
+/* -- famílias: rótulo discreto, não compete com os itens -- */
+.fisioIndiceFamilia {
+  font-size: 1.1rem;
+  font-weight: 700;
+  letter-spacing: 0.09rem;
+  text-transform: uppercase;
+  color: var(--roxo9);
+  margin-bottom: 0.6rem;
+  padding-left: 1rem;
+}
+
+.fisioIndiceGrupo + .fisioIndiceGrupo {
+  margin-top: 1.25rem;
+}
+
+/* -- itens: alvo maior, afordância explícita de clique -- */
+.fisioIndice li + li {
+  margin-top: 0.1rem;
+}
+
+.fisioIndice a {
+  position: relative;
+  font-size: 1.45rem;
+  line-height: 1.3;
+  color: var(--cinza2);
+  border-left: 0;
+  border-radius: 0.8rem;
+  padding: 0.48rem 1rem 0.48rem 2.2rem;
+  transition: background-color 0.18s ease, color 0.18s ease;
+}
+
+/* marcador que acende: diz "isto é um destino", sem poluir parado */
+.fisioIndice a::before {
+  content: "";
+  position: absolute;
+  left: 1rem;
+  top: 1.05rem;
+  width: 4px;
+  height: 4px;
+  border-radius: 50%;
+  background: var(--roxo9);
+  transition: background-color 0.18s ease, transform 0.18s ease;
+}
+
+.fisioIndice a:hover,
+.fisioIndice a:focus-visible {
+  background-color: var(--rosa1);
+  color: var(--roxo6);
+  border-left-color: transparent;
+}
+
+.fisioIndice a:hover::before,
+.fisioIndice a:focus-visible::before {
+  background: var(--verde3);
+  transform: scale(1.8);
+}
+
+@media (min-width: 1001px) {
+  /* Sem scroll interno: com os itens compactados o índice inteiro cabe na
+     viewport, e um painel de navegação com barra de rolagem própria é
+     justamente o que dava sensação de improviso. */
+  .fisioIndice {
+    max-height: none;
+    overflow-y: visible;
+  }
+
+  .fisioLayout {
+    grid-template-columns: minmax(0, 27rem) minmax(0, var(--medida));
+  }
+}
+
+/* -- mobile: lista vertical (≈630px) vira fluxo de pílulas -- */
+@media (max-width: 1000px) {
+  .fisioIndice {
+    padding: 2rem 1.6rem;
+  }
+
+  .fisioIndice ul {
+    display: flex;
