     font-size: 1.5rem;
   }
 }
+
+/* ============================================================
+   PROTÓTIPO COORDENADOR — redesign do dropdown, indicador e seta
+   (desktop; mobile mantido)
+   ============================================================ */
+@media (min-width: 1001px) {
+  /* -- indicador de página ativa: bolinha -> sublinhado -- */
+  .navMenuHeader a::before,
+  .navMenuHeader a:not(.active)::before,
+  .navMenuHeader a.active::before {
+    content: none !important;
+  }
+  .navMenuHeader > a,
+  .navMenuHeader .navDropdownTrigger > a {
+    position: relative;
+  }
+  .navMenuHeader > a::after,
+  .navMenuHeader .navDropdownTrigger > a::after {
+    content: "";
+    position: absolute;
+    left: 2rem;
+    right: 2rem;
+    bottom: 2.3rem;
+    height: 2px;
+    border-radius: 2px;
+    background: var(--verde1);
+    transform: scaleX(0);
+    transform-origin: center left;
+    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
+  }
+  .navMenuHeader .navDropdownTrigger > a::after {
+    right: 0.5rem;
+  }
+  .navMenuHeader > a:hover::after,
+  .navMenuHeader .navDropdownTrigger > a:hover::after {
+    transform: scaleX(0.4);
+  }
+  .navMenuHeader > a.active::after,
+  .navMenuHeader .navDropdownTrigger > a.active::after {
+    transform: scaleX(1);
+  }
+
+  /* -- seta: mais fina, discreta, acende quando aberta -- */
+  .navDropdownChevron {
+    width: 7px;
+    height: 7px;
+    border-right-width: 1.5px;
+    border-bottom-width: 1.5px;
+    color: rgba(255, 255, 255, 0.62);
+    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
+      color 0.2s ease-in-out;
+  }
+  .navDropdownTrigger:hover .navDropdownChevron,
+  .navDropdownOpen .navDropdownChevron {
+    color: var(--verde1);
+  }
+
+  /* -- painel: vidro escuro, cantos completos, sombra difusa -- */
+  .navDropdownPanel {
+    top: calc(100% - 0.8rem);
+    left: 1rem;
+    min-width: 28rem;
+    padding: 0.8rem;
+    background-color: rgba(52, 16, 79, 0.82);
+    backdrop-filter: blur(14px) saturate(140%);
+    -webkit-backdrop-filter: blur(14px) saturate(140%);
+    border: 1px solid rgba(255, 255, 255, 0.14);
+    border-radius: 1.4rem;
+    box-shadow: 0 18px 44px -12px rgba(30, 8, 48, 0.55),
+      0 2px 8px rgba(30, 8, 48, 0.3);
+  }
+
+  /* -- itens: pílula com respiro, indicador verde à esquerda -- */
+  .navMenu .navDropdownPanel a {
+    position: relative;
+    padding: 1.25rem 1.6rem 1.25rem 2.4rem;
+    border-radius: 0.9rem;
+    font-size: 1.5rem;
+    color: rgba(255, 255, 255, 0.86);
+    transition: background-color 0.18s ease-in-out, color 0.18s ease-in-out;
+  }
+  .navMenu .navDropdownPanel a::after {
+    content: "";
+    position: absolute;
+    left: 1rem;
+    top: 50%;
+    width: 3px;
+    height: 0;
+    border-radius: 3px;
+    background: var(--verde1);
+    transform: translateY(-50%);
+    transition: height 0.22s cubic-bezier(0.4, 0, 0.2, 1);
+  }
+  .navMenu .navDropdownPanel a:hover {
+    background-color: rgba(255, 255, 255, 0.1);
+    color: var(--branco);
+  }
+  .navMenu .navDropdownPanel a:hover::after {
+    height: 14px;
+  }
+  .navMenu .navDropdownPanel a.active {
+    background-color: rgba(255, 255, 255, 0.14);
+    color: var(--branco);
+    font-weight: 600;
+  }
+  .navMenu .navDropdownPanel a.active::after {
+    height: 20px;
+  }
+}
